{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "insightclaritiysolution.com" }],
      "destination": "https://www.claritiy.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.insightclaritiysolution.com" }],
      "destination": "https://www.claritiy.com/$1",
      "permanent": true
    },
    {
      "source": "/compare",
      "destination": "https://www.claritiy.com/solutions",
      "permanent": true
    },
    {
      "source": "/industries",
      "destination": "https://www.claritiy.com/use-cases",
      "permanent": true
    },
    {
      "source": "/industries/:path*",
      "destination": "https://www.claritiy.com/use-cases/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/((?!assets|favicon\\.ico|sitemap\\.xml|robots\\.txt|admin).*)", "destination": "/index.html" }
  ]
}

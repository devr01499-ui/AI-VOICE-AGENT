{
  "name": "claritiy-voice-server",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:check-drift": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test:security": "node scripts/test_phase5_security_suite.js",
    "test:owasp": "node scripts/test_owasp_top10_audit.js",
    "test:payment-security": "node scripts/test_payment_gateway_security.js",
    "test:plivo-webhook": "node scripts/test_plivo_webhook_security.js",
    "test:audiostream-isolation": "node scripts/test_audiostream_isolation.js",
    "test:live-transcript-auth": "node scripts/test_live_transcript_auth.js",
    "test:batch-a": "node scripts/test_plivo_webhook_security.js && node scripts/test_audiostream_isolation.js && node scripts/test_live_transcript_auth.js",
    "test:batch-b": "node scripts/test_call_statemachine_concurrency.js",
    "test:batch-c": "node scripts/test_monetization_ledger.js",
    "test:batch-d": "node scripts/test_audio_pipeline_reliability.js",
    "test:batch-e": "node scripts/test_webhook_idempotency_replay.js",
    "test:batch-f": "node scripts/test_observability_health_telemetry.js",
    "test:street-smart": "npx tsx scripts/test_street_smart_intelligence.ts",
    "test:street-smart-regression": "npx tsx -r dotenv/config scripts/test_street_smart_regression.ts",
    "eval:street-smart-live": "npx tsx -r dotenv/config scripts/eval_street_smart_live.ts",
    "test:m1-pipeline": "npx tsx -r dotenv/config scripts/test_call_finalizer_idempotency.ts",
    "test:normalizers": "npx tsx scripts/test_normalizers_hinglish.ts",
    "test:speaker-attribution": "npx tsx scripts/test_speaker_attribution.ts",
    "test:prompt-injection": "npx tsx scripts/test_prompt_injection.ts",
    "test:evidence": "npx tsx scripts/test_evidence_substring_check.ts",
    "test:m2-accuracy": "npx tsx scripts/test_normalizers_hinglish.ts && npx tsx scripts/test_speaker_attribution.ts && npx tsx scripts/test_prompt_injection.ts && npx tsx scripts/test_evidence_substring_check.ts && npx tsx scripts/test_m2_mechanics_suite.ts",
    "eval:reports": "npx tsx -r dotenv/config scripts/eval/run_eval_harness.ts",
    "eval:smoke": "npx tsx -r dotenv/config scripts/eval/run_eval_harness.ts --smoke"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.110.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "better-sqlite3": "^12.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drachtio-srf": "^5.0.27",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "razorpay": "^2.9.8",
    "resend": "^6.18.0",
    "sip.js": "^0.21.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@ngrok/ngrok": "^1.4.0"
  }
}
